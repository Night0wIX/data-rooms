generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  // Supabase Auth user ID.
  id        String   @id
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataRooms      DataRoom[]
  uploadedFiles  File[]
  createdShares  Share[]    @relation("ShareCreatedBy")
  receivedShares Share[]    @relation("ShareGrantedTo")

  @@map("users")
}

model DataRoom {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  folders Folder[]
  files   File[]

  @@index([ownerId])
  @@map("data_rooms")
}

model Folder {
  id         String   @id @default(uuid())
  dataRoomId String
  dataRoom   DataRoom @relation(fields: [dataRoomId], references: [id], onDelete: Restrict)
  parentId   String?
  parent     Folder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Restrict)
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  children Folder[] @relation("FolderChildren")
  files    File[]

  // Unique among siblings; root uniqueness is enforced by the service.
  @@unique([dataRoomId, parentId, name])

  // Supports folder listing by room and parent.
  @@index([dataRoomId, parentId])
  @@index([parentId])
  @@map("folders")
}

enum FileStatus {
  PENDING
  READY
  FAILED
}

model File {
  id       String @id @default(uuid())
  folderId String
  folder   Folder @relation(fields: [folderId], references: [id], onDelete: Restrict)

  // Denormalized for room-wide queries.
  dataRoomId String
  dataRoom   DataRoom @relation(fields: [dataRoomId], references: [id], onDelete: Restrict)

  displayName String
  storageKey  String     @unique
  mimeType    String
  sizeBytes   Int
  status      FileStatus @default(PENDING)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevents duplicate names during concurrent uploads.
  @@unique([folderId, displayName])

  @@index([dataRoomId, createdAt])
  @@index([folderId, createdAt])
  @@map("files")
}

enum ShareResourceType {
  DATA_ROOM
  FOLDER
  FILE
}

enum ShareType {
  PUBLIC
  USER
}

enum ShareRole {
  VIEWER
  EDITOR
}

model Share {
  id           String            @id @default(uuid())
  resourceType ShareResourceType
  resourceId   String

  shareType ShareType
  role      ShareRole @default(VIEWER)

  sharedWithUserId String?
  sharedWithUser   User?   @relation("ShareGrantedTo", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  token String? @unique

  createdById String
  createdBy   User      @relation("ShareCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  // Resource integrity is validated by SharingService.
  @@unique([resourceType, resourceId, sharedWithUserId])
  @@index([resourceType, resourceId, revokedAt])
  @@index([sharedWithUserId])
  @@map("shares")
}