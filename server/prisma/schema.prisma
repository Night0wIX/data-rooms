generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataRooms     DataRoom[]
  uploadedFiles File[]

  @@map("users")
}

model DataRoom {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  folders Folder[]
  files   File[]

  @@index([ownerId])
  @@map("data_rooms")
}

model Folder {
  id         String   @id @default(uuid())
  dataRoomId String
  dataRoom   DataRoom @relation(fields: [dataRoomId], references: [id], onDelete: Restrict)
  parentId   String?
  parent     Folder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Restrict)
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  children Folder[] @relation("FolderChildren")
  files    File[]

  @@unique([dataRoomId, parentId, name])
  @@index([dataRoomId, parentId])
  @@index([parentId])
  @@map("folders")
}

enum FileStatus {
  PENDING
  READY
  FAILED
}

model File {
  id       String @id @default(uuid())
  folderId String
  folder   Folder @relation(fields: [folderId], references: [id], onDelete: Restrict)

  dataRoomId String
  dataRoom   DataRoom @relation(fields: [dataRoomId], references: [id], onDelete: Restrict)

  displayName String
  storageKey  String     @unique
  mimeType    String
  sizeBytes   Int
  status      FileStatus @default(PENDING)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([folderId, displayName])
  @@index([dataRoomId, createdAt])
  @@index([folderId, createdAt])
  @@map("files")
}